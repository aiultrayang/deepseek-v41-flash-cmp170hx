+GiB = 1024**3
+
+
+def plan_engram_cache(
+    cache_gib: float, num_embeddings: tuple[int, ...], head_dim: int
+) -> tuple[int, ...]:
+    """Split the host row-cache budget evenly, capped by FP8 table bytes.
+
+    Ported from the DeepSeek hybrid branch's cache planner: tables that use
+    less than their share return the remainder to the larger ones.
+    """
+    sizes = [rows * (head_dim + head_dim // 32) for rows in num_embeddings]
+    total = sum(sizes)
+    remaining = total if cache_gib >= total / GiB else int(cache_gib * GiB)
+    result = [0] * len(sizes)
+    for rank, index in enumerate(sorted(range(len(sizes)), key=sizes.__getitem__)):
+        result[index] = min(sizes[index], remaining // (len(sizes) - rank))
+        remaining -= result[index]
+    return tuple(result)
+
